@startuml
title Submission and kitchen update
actor User
participant RestaurantPanel as UI
participant MealCreator as Factory
participant Extra
participant OrderFacade as Facade
participant OrderBuilder as Builder
participant DiscountStrategy as Strategy
participant OrderService as Service
participant Order
participant OrderState as State
participant "Customer handler" as Customer
participant "Kitchen handler" as Kitchen
User -> UI : choose meal and extras
UI -> Factory : prepare()
Factory --> UI : Meal
UI -> Extra : wrap(meal)
User -> UI : submit
UI -> Facade : placeOrder(cart, strategy)
Facade -> Builder : withDiscount(strategy)
loop each cart meal
Facade -> Builder : addMeal(meal)
Builder -> Extra : description(), price()
end
Facade -> Service : submit(builder)
Service -> Builder : build(nextId)
Builder -> Strategy : discount(subtotal)
Strategy --> Builder : discount amount
Builder -> Order : new Order (Pending)
Builder --> Service : order
Service -> Customer : orderChanged(order)
Service -> Kitchen : orderChanged(order)
Service --> Facade : order
Facade --> UI : order
User -> UI : advance selected order
UI -> Service : advance(id)
Service -> Order : advance()
Order -> State : next()
State --> Order : Preparing
Service -> Customer : orderChanged(order)
Service -> Kitchen : orderChanged(order)
@enduml
